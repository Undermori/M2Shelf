{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "M²Shelf",
  "version": "0.5.13",
  "identifier": "app.morimediashelf.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "M²Shelf",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; font-src 'self' blob:; img-src 'self' data: blob: asset: http://asset.localhost https://image.tmdb.org https://lain.bgm.tv; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/cache/covers/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/M2ShelfMobi"],
    "resources": {
      "resources/M2ShelfMobi-source.zip": "M2ShelfMobi-source.zip",
      "native/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "shortDescription": "只读浏览本地媒体收藏",
    "longDescription": "M²Shelf 是一个面向 Windows 本地硬盘收藏的可视化媒体资源浏览器。"
  }
}
